# ==== Telegram bot ====
# Tokenni @BotFather dan oling
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# WebApp ochiladigan HTTPS url (bot tugmasi shu manzilga olib boradi)
# Masalan: https://sizning-domen.uz yoki https://xxxx.ngrok.app
WEBAPP_URL=https://your-domain.example

# Bot adminlari (Telegram ID lar, vergul bilan). Bu foydalanuvchilar avtomatik admin bo'ladi.
ADMIN_IDS=123456789

# ==== MySQL ====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hamyon

# ==== Web server ====
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Session uchun maxfiy kalit (bo'sh qoldirilsa BOT_TOKEN ishlatiladi)
SECRET_KEY=
